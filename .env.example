# Public site URL used for canonical links and deployment documentation.
SITE_URL=https://forum.example.com

# Local development defaults. Docker Compose overrides both paths to /data so
# the database and uploaded images are persisted and backed up together.
DATABASE_PATH=.data/ai-forum.db

# Images pasted or selected in the post editor are stored here.
UPLOAD_DIR=.data/uploads

# Seed the eight demonstration topics only when the database has no topics.
SEED_DEMO_CONTENT=true

# Production: prefer a scrypt hash generated by `npm run password:hash -- "your password"`.
ADMIN_PASSWORD_HASH=

# Local-only convenience. Do not use a plaintext password in production.
ADMIN_PASSWORD=

# Random secret used when hashing anonymous view fingerprints.
VIEW_HASH_SECRET=replace-with-a-long-random-string

# Trust Cloudflare/Nginx client-IP headers only when the origin is inaccessible
# from the public Internet. Docker Compose binds the origin to 127.0.0.1.
TRUST_PROXY=false

# Maximum total uploaded-image storage. Default: 2048 MB.
UPLOAD_QUOTA_MB=2048
